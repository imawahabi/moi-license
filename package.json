{
  "name": "moi-licenses",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "نظام متابعة الإستئذانات - وزارة الداخلية الكويتية",
  "author": "Ministry of Interior - Kuwait",
  "main": "electron/main.cjs",
  "homepage": ".",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "npx concurrently \"npm:dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "dist": "npm run build && electron-builder --publish=never",
    "build:electron": "node build-electron.cjs",
    "build:icons": "node build-icons.cjs",
    "dev:backend": "npm --prefix backend run dev",
    "dev:full": "npx concurrently \"npm:dev\" \"npm --prefix backend run dev\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.51.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "docx": "^9.5.1",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.344.0",
    "mysql2": "^3.6.5",
    "pdfmake": "^0.2.20",
    "react": "^18.3.1",
    "react-datepicker": "^8.4.0",
    "react-dom": "^18.3.1",
    "react-select": "^5.10.2",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^37.2.5",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.moi.licenses.app",
    "productName": "Moi-Licenses",
    "icon": "icons/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*",
      "!backend/node_modules",
      "fix-database-issues.cjs"
    ],
    "extraResources": [
      {
        "from": "backend/database.json",
        "to": "database.json"
      }
    ],
    "directories": {
      "buildResources": "icons",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "نظام متابعة الإستئذانات"
    },
    "portable": {
      "artifactName": "Moi-Licenses-Portable.exe"
    }
  }
}
